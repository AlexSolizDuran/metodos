@inherits DatosComponenteBase

<section class="seccion">
    <div class="seccion-head">
        <div>
            <h2>Comparación de métodos numéricos</h2>
            <p class="subtitulo">Cálculo de la raíz de Φ(x) − 0.95 = 0 con bisección y Newton-Raphson.</p>
        </div>
        <span class="chip">Tolerancia @Formato.Cientifico(Configuracion.Tolerancia)</span>
    </div>

    <div class="formulas">
        <p class="formulas-titulo">Fórmulas del umbral estadístico</p>
        <div class="formula-grid">
            <div class="formula-item">
                <p class="formula-nombre">Ecuación del percentil 95 &nbsp;·&nbsp; Φ(x) − 0,95 = 0</p>
                <p class="formula-ecuacion">
                    Φ(x) − 0,95 = 0
                    <span class="formula-resultado">→&nbsp; x = @Formato.Numero(_biseccion.Valor, 6)</span>
                </p>
                <p class="formula-significado">Se resuelve con bisección y Newton-Raphson: valor, iteraciones y error en la tabla.</p>
            </div>
            <div class="formula-item">
                <p class="formula-nombre">Umbral &nbsp;·&nbsp; T = μ + x · σ</p>
                @if (Datos.Estadistica is EstadisticaReferencia estadistica && Datos.Umbral is double umbralFormula)
                {
                    <p class="formula-ecuacion">
                        T = @Formato.Numero(estadistica.Media, 4) + @Formato.Numero(_biseccion.Valor, 4) × @Formato.Numero(estadistica.Desviacion, 4)
                        <span class="formula-resultado">= @Formato.Numero(umbralFormula, 4) → @((int)Math.Ceiling(umbralFormula)) fallidos</span>
                    </p>
                    <p class="formula-significado">μ media y σ desviación de la referencia · @estadistica.CantidadIp IP normales.</p>
                }
                else
                {
                    <p class="formula-ecuacion">T = μ + x · σ</p>
                    <p class="formula-significado">Carga <b>referencia.csv</b> para sustituir μ y σ por los valores reales.</p>
                }
            </div>
        </div>
    </div>

    <div class="tabla-scroll">
        <table class="tabla">
            <thead>
                <tr>
                    <th>Método</th>
                    <th class="num">Valor</th>
                    <th class="num">Iteraciones</th>
                    <th class="num">Error</th>
                    <th>Convergió</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Bisección</td>
                    <td class="num mono">@Formato.Numero(_biseccion.Valor, 6)</td>
                    <td class="num">@_biseccion.Iteraciones</td>
                    <td class="num mono">@Formato.Cientifico(_biseccion.Error)</td>
                    <td>
                        <span class="badge @(_biseccion.Convergio ? "badge-ok" : "badge-peligro")">
                            @(_biseccion.Convergio ? "Sí" : "No")
                        </span>
                    </td>
                </tr>
                <tr>
                    <td>Newton-Raphson</td>
                    <td class="num mono">@Formato.Numero(_newton.Valor, 6)</td>
                    <td class="num">@_newton.Iteraciones</td>
                    <td class="num mono">@Formato.Cientifico(_newton.Error)</td>
                    <td>
                        <span class="badge @(_newton.Convergio ? "badge-ok" : "badge-peligro")">
                            @(_newton.Convergio ? "Sí" : "No")
                        </span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <p class="resumen-linea">
        Diferencia entre valores: @Formato.Cientifico(Math.Abs(_biseccion.Valor - _newton.Valor))
        <span aria-hidden="true">·</span> Ahorro de iteraciones: @Math.Abs(_biseccion.Iteraciones - _newton.Iteraciones)
        <span aria-hidden="true">·</span> Más rápido: @(_biseccion.Iteraciones <= _newton.Iteraciones ? "Bisección" : "Newton-Raphson")
        @if (Datos.Umbral is double umbral)
        {
            <span aria-hidden="true">·</span> <span>Umbral: @Formato.Numero(umbral, 4) → @((int)Math.Ceiling(umbral)) fallidos</span>
        }
    </p>

    <div class="grid grid-2">
        <GraficoLineas Titulo="Error de bisección (log₁₀)" Unidad="log"
                       Valores="@_erroresBiseccion" Etiquetas="@_etiquetasBiseccion"
                       Color="#38bdf8" />
        <GraficoLineas Titulo="Error de Newton (log₁₀)" Unidad="log"
                       Valores="@_erroresNewton" Etiquetas="@_etiquetasNewton"
                       Color="#34d399" />
    </div>

    <details class="detalle-tabla">
        <summary>Ver iteraciones de bisección (@_biseccion.Pasos.Count)</summary>
        <div class="tabla-scroll">
            <table class="tabla">
                <thead>
                    <tr>
                        <th class="num">i</th>
                        <th class="num">a</th>
                        <th class="num">b</th>
                        <th class="num">c</th>
                        <th class="num">f(c)</th>
                        <th class="num">error</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (PasoRaiz paso in _biseccion.Pasos)
                    {
                        <tr>
                            <td class="num">@paso.Iteracion</td>
                            <td class="num mono">@Formato.Numero(paso.A, 6)</td>
                            <td class="num mono">@Formato.Numero(paso.B, 6)</td>
                            <td class="num mono">@Formato.Numero(paso.Punto, 6)</td>
                            <td class="num mono">@Formato.Cientifico(paso.Funcion)</td>
                            <td class="num mono">@Formato.Cientifico(paso.Error)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>

    <details class="detalle-tabla">
        <summary>Ver iteraciones de Newton-Raphson (@_newton.Pasos.Count)</summary>
        <div class="tabla-scroll">
            <table class="tabla">
                <thead>
                    <tr>
                        <th class="num">i</th>
                        <th class="num">x</th>
                        <th class="num">f(x)</th>
                        <th class="num">f'(x)</th>
                        <th class="num">error</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (PasoRaiz paso in _newton.Pasos)
                    {
                        <tr>
                            <td class="num">@paso.Iteracion</td>
                            <td class="num mono">@Formato.Numero(paso.Punto, 6)</td>
                            <td class="num mono">@Formato.Cientifico(paso.Funcion)</td>
                            <td class="num mono">@Formato.Cientifico(paso.Derivada)</td>
                            <td class="num mono">@Formato.Cientifico(paso.Error)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>
</section>

@code {
    private ResultadoRaiz _biseccion = new();
    private ResultadoRaiz _newton = new();
    private List<double> _erroresBiseccion = new();
    private List<double> _erroresNewton = new();
    private List<string> _etiquetasBiseccion = new();
    private List<string> _etiquetasNewton = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Func<double, double> ecuacion = x =>
            NormalEstandar.Acumulada(x) - Configuracion.NivelConfianza;

        _biseccion = MetodoBiseccion.Calcular(
            ecuacion, -6.0, 6.0,
            Configuracion.Tolerancia,
            Configuracion.IteracionesMaximasBiseccion);

        _newton = MetodoNewton.Calcular(
            ecuacion, NormalEstandar.Densidad, 0.0,
            Configuracion.Tolerancia,
            Configuracion.IteracionesMaximasNewton);

        _erroresBiseccion = _biseccion.Pasos
            .Select(p => Math.Log10(Math.Max(p.Error, 1e-16)))
            .ToList();
        _erroresNewton = _newton.Pasos
            .Select(p => Math.Log10(Math.Max(p.Error, 1e-16)))
            .ToList();
        _etiquetasBiseccion = _biseccion.Pasos
            .Select(p => p.Iteracion.ToString())
            .ToList();
        _etiquetasNewton = _newton.Pasos
            .Select(p => p.Iteracion.ToString())
            .ToList();
    }
}
