@inherits DatosComponenteBase

@{
    Dictionary<string, List<Registro>> grupos = Datos.Grupos;
    List<string> ips = grupos.Keys.OrderBy(k => k, StringComparer.Ordinal).ToList();
    string? ipActual = _ipSeleccionada is not null && grupos.ContainsKey(_ipSeleccionada)
        ? _ipSeleccionada
        : ips.FirstOrDefault();

    ResultadoTemporal? temporal = ipActual is not null
        ? DiferenciasFinitas.Calcular(grupos[ipActual], Configuracion.TamanoVentana)
        : null;

    List<string> etiquetas = temporal is null
        ? new List<string>()
        : temporal.MarcasTiempo.Select(Formato.Hora).ToList();
    List<string> etiquetasAceleracion = etiquetas.Skip(1).ToList();
}

<section class="seccion">
    <div class="seccion-head">
        <div>
            <h2>Análisis temporal por IP</h2>
            <p class="subtitulo">Evolución en la ventana móvil de
                @Configuracion.TamanoVentana intentos: intervalo, frecuencia y aceleración.</p>
        </div>
        @if (ips.Count > 0)
        {
            <label class="selector">
                <span>IP</span>
                <select value="@ipActual" @onchange="CambiarIp">
                    @foreach (string ip in ips)
                    {
                        <option value="@ip">@ip</option>
                    }
                </select>
            </label>
        }
    </div>

    <div class="formulas">
        <p class="formulas-titulo">Fórmulas de diferencias finitas</p>
        <div class="formula-grid">
            <div class="formula-item">
                <p class="formula-nombre">Intervalo &nbsp;·&nbsp; h<sub>i</sub></p>
                <p class="formula-ecuacion">
                    h<sub>i</sub> = t<sub>i</sub> − t<sub>i−1</sub>
                </p>
                <p class="formula-significado">Tiempo entre dos intentos consecutivos, en segundos.</p>
            </div>
            <div class="formula-item">
                <p class="formula-nombre">Frecuencia &nbsp;·&nbsp; v<sub>i</sub></p>
                <p class="formula-ecuacion">
                    v<sub>i</sub> = <span class="frac"><span class="frac-num">1</span><span class="frac-den">h<sub>i</sub></span></span>
                </p>
                <p class="formula-significado">Intentos por segundo. Si crece, hay aceleración.</p>
            </div>
            <div class="formula-item">
                <p class="formula-nombre">Aceleración &nbsp;·&nbsp; a<sub>i</sub></p>
                <p class="formula-ecuacion">
                    a<sub>i</sub> = <span class="frac"><span class="frac-num">v<sub>i</sub> − v<sub>i−1</sub></span><span class="frac-den">(h<sub>i</sub> + h<sub>i−1</sub>) / 2</span></span>
                </p>
                <p class="formula-significado">Cómo cambia la frecuencia en el tiempo.</p>
            </div>
        </div>
    </div>

    @if (temporal is null || ipActual is null)
    {
        <p class="vacio">No hay registros para analizar.</p>
    }
    else if (!temporal.HayDatos)
    {
        <p class="vacio">
            Se necesitan al menos dos intentos con fechas distintas.
            @if (temporal.IntervalosIgnorados > 0)
            {
                <span> Intervalos descartados: @temporal.IntervalosIgnorados.</span>
            }
        </p>
    }
    else
    {
        <p class="resumen-linea">
            @temporal.IntentosAnalizados intentos en ventana
            <span aria-hidden="true">·</span> @temporal.IntentosFallidos fallidos
            <span aria-hidden="true">·</span> Frecuencia actual: @Formato.Numero(temporal.FrecuenciaActual, 4) int/s
            <span aria-hidden="true">·</span> Variación: @temporal.Variacion
            <span aria-hidden="true">·</span> Aceleración media: @Formato.ConSigno(temporal.PromedioAceleracion, 6)
        </p>

        <div class="grid grid-2">
            <GraficoLineas Titulo="Frecuencia v_i" Unidad="int/s"
                           Valores="@temporal.Frecuencias" Etiquetas="@etiquetas"
                           Color="#38bdf8" />
            <GraficoLineas Titulo="Intervalo h_i" Unidad="s"
                           Valores="@temporal.Intervalos" Etiquetas="@etiquetas"
                           Color="#a78bfa" />
        </div>

        <GraficoLineas Titulo="Aceleración a_i" Unidad="int/s²"
                       Valores="@temporal.Aceleraciones" Etiquetas="@etiquetasAceleracion"
                       Color="#f59e0b" />

        <div class="tabla-scroll">
            <table class="tabla">
                <thead>
                    <tr>
                        <th class="num">t (s)</th>
                        <th class="num">h (s)</th>
                        <th class="num">v (int/s)</th>
                        <th class="num">a (int/s²)</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < temporal.Intervalos.Count; i++)
                    {
                        double t = (temporal.MarcasTiempo[i] - temporal.Inicio).TotalSeconds;
                        string aceleracion = i >= 1
                            ? Formato.ConSigno(temporal.Aceleraciones[i - 1], 6)
                            : "—";

                        <tr>
                            <td class="num mono">@Formato.Numero(t, 4)</td>
                            <td class="num mono">@Formato.Numero(temporal.Intervalos[i], 4)</td>
                            <td class="num mono">@Formato.Numero(temporal.Frecuencias[i], 6)</td>
                            <td class="num mono">@aceleracion</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (temporal.IntervalosIgnorados > 0)
        {
            <p class="nota">Intervalos descartados (h ≤ 0): @temporal.IntervalosIgnorados.</p>
        }
    }
</section>

@code {
    private string? _ipSeleccionada;

    private void CambiarIp(ChangeEventArgs e)
    {
        _ipSeleccionada = e.Value?.ToString();
    }
}
