@page "/"
@inherits DatosComponenteBase

@{
    int totalAlertas = Datos.CalcularAlertas().Count(a => a.EsSospechosa);
}

<div class="pagina">
    <div class="pagina-fija">
        <header class="hero">
            <p class="hero-kicker">Métodos Numéricos · Seguridad de autenticación</p>
            <h1 class="hero-titulo">Detección de fuerza bruta en registros de acceso</h1>
            
        </header>

        <nav class="tabs" role="tablist">
            <button class="tab @(Pestana == "datos" ? "active" : "")" @onclick='() => Pestana = "datos"'>Datos</button>
            <button class="tab @(Pestana == "estadisticas" ? "active" : "")"
                    @onclick='() => Pestana = "estadisticas"'>Estadísticas</button>
            <button class="tab @(Pestana == "temporal" ? "active" : "")" @onclick='() => Pestana = "temporal"'>Análisis
                temporal</button>
                <button class="tab @(Pestana == "metodos" ? "active" : "")" @onclick='() => Pestana = "metodos"'>Métodos
                    numéricos</button>
                    <button class="tab @(Pestana == "alertas" ? "active" : "")"
                            @onclick='() => Pestana = "alertas"'>Alertas</button>
                </nav>
            </div>

            <div class="pagina-cuerpo" @key="Pestana">
                @switch (Pestana)
                {
                    case "datos":
                        <div class="pila">
                            <CargarDatos />
                            <Simulacion />
                        </div>
                        break;

                    case "estadisticas":
                        <TablaEstadisticas />
                        break;

                    case "temporal":
                        <AnalisisTemporal />
                        break;

                    case "metodos":
                        <ComparacionMetodos />
                        break;

                    case "alertas":
                        <PanelAlertas />
                        break;
                }
            </div>
        </div>

@code {
    private string Pestana { get; set; } = "datos";

    protected override async Task OnInitializedAsync()
    {
        await Datos.InicializarAsync();
    }
}
